# CitizenConnect — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# Port for the main Express API server (Phase 1+)
PORT=4000

# Host to bind (127.0.0.1 for local-only; 0.0.0.0 for Docker / cloud)
HOST=127.0.0.1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── AI Assist (existing aiServer.mjs on port 5050) ──────────────────────────
# URL of the companion AI extraction server
AI_SERVER_URL=http://127.0.0.1:5050

# Optional: real AI provider API key (leave blank to use demo mode)
CITIZENCONNECT_AI_API_KEY=

# ─── Database (PostgreSQL via Prisma ORM) ────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@host:5432/citizenconnect_dev?schema=public"

# ─── Authentication & Sessions (Phase 3) ─────────────────────────────────────
# Strong random secret for session signing — use at least 64 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-min-64-chars

# Session cookie lifetime in milliseconds (default: 604800000 = 7 days)
SESSION_COOKIE_MAX_AGE=604800000

# bcrypt work factor — higher = more secure but slower (default: 12, range: 10-14)
BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
# morgan log format: combined | common | dev | short | tiny
LOG_LEVEL=dev
